<div id="chat-launcher">

    <div class="launcher-circle">
        🤖
    </div>

</div>


<div class="chat-container" id="chatContainer">

    <!-- ================= HEADER ================= -->

    <div class="chat-header">

        <div class="chat-header-left">

            <div class="bot-avatar">
                🤖
            </div>

            <div>

                <div class="assistant-title">
                    BALCO Connect AI
                </div>

                <div class="assistant-subtitle">
                    Bhoramdev Vidyapeeth Coaching
                </div>

            </div>

        </div>

        <div class="header-icons">

            <span
                id="resetChat"
                title="New Chat">
                🔄
            </span>

            <span
                id="closeChat"
                title="Close">
                ✖
            </span>

        </div>

    </div>

    <!-- ================= CHAT BODY ================= -->

    <div
        class="chat-body"
        id="chatBody">

        <!-- Welcome Screen -->

        <div
            class="welcome-box"
            id="welcomeBox">

            <div class="welcome-logo">

                🤖

            </div>

            <h2>

                Welcome to

                <br>

                BALCO Connect

            </h2>

            <p>

                Bhoramdev Vidyapeeth Coaching Program

            </p>

            <div class="welcome-card">

                I can help you with

            </div>

            <!-- Quick Buttons -->

            <div class="quick-actions">

                <button onclick="sendQuick('Enrollment')">

                    👨‍🎓 Enrollment

                </button>

                <button onclick="sendQuick('Attendance')">

                    📊 Attendance

                </button>

                <button onclick="sendQuick('Syllabus status')">

                    📚 Syllabus

                </button>

                <button onclick="sendQuick('Achievements')">

                    🏆Achievements

                </button>

                <button onclick="sendQuick('Employment')">

                    💼 Employment

                </button>

                <button onclick="sendQuick('Faculty')">

                    👨‍🏫 Faculty

                </button>

                <button onclick="sendQuick('Latest Notice')">

                    📢 Notice

                </button>

                <button onclick="sendQuick('Library')">

                    📖 Library

                </button>

              </div>

        </div>

        <div id="messages"></div>

    </div>

    <!-- ================= FOOTER ================= -->

    <div class="chat-footer">

        <input

            id="message"

            type="text"

            placeholder="Ask me anything..."

            autocomplete="off"

            onkeypress="if(event.key==='Enter'){sendMessage()}"

        >

        <button

            id="sendBtn"

            onclick="sendMessage()">

            ➤

        </button>

    </div>

</div>

<script>
const launcher = document.getElementById("chat-launcher");
const chatContainer = document.getElementById("chatContainer");
const closeChat = document.getElementById("closeChat");
const resetChat = document.getElementById("resetChat");
const chatBody = document.getElementById("chatBody");
const messages = document.getElementById("messages");
const message = document.getElementById("message");

// Open
launcher.onclick = () => {
    chatContainer.style.display = "flex";
};

// Close
closeChat.onclick = () => {
    chatContainer.style.display = "none";
};

// Reset
resetChat.onclick = () => {

    messages.innerHTML = "";

    message.value = "";

    chatBody.scrollTop = 0;

};

async function sendMessage() {

    const text = message.value.trim();

    if (!text) return;

    addUserMessage(text);

    message.value = "";

    try {

        showTyping();

        const res = await fetch("/api/chat", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({
                message: text
            })

        });

        const data = await res.json();

        hideTyping();

        addBotMessage(
            data.reply,
            data.suggestions || []
        );

    } catch (err) {

        hideTyping();

        addBotMessage(
            "❌ Unable to connect to AI."
        );

    }

}
function addUserMessage(text){

    messages.insertAdjacentHTML(
        "beforeend",
        `
        <div class="user-message">
            ${text}
        </div>
        `
    );

    scrollBottom();

}

function addBotMessage(reply,suggestions=[]){

    let html=`

    <div class="bot-message">

        ${reply.replace(/\n/g,"<br>")}
    `;

    if(suggestions.length){

        html+=`

        <div class="chat-suggestions">

        `;

        suggestions.forEach(item=>{

            html+=`

            <button
                class="chat-chip"
                onclick="sendQuick('${item}')">

                ${item}

            </button>

            `;

        });

        html+=`

        </div>

        `;

    }

    html+=`

    </div>

    `;

    messages.insertAdjacentHTML(
        "beforeend",
        html
    );

    scrollBottom();

}

function showTyping(){

    messages.insertAdjacentHTML(
        "beforeend",
        `
        <div
            class="bot-message"
            id="typing">

            🤖 Thinking...

        </div>
        `
    );

    scrollBottom();

}

function hideTyping(){

    document
    .getElementById("typing")
    ?.remove();

}

function scrollBottom(){

    chatBody.scrollTop =
    chatBody.scrollHeight;

}

function sendQuick(text){

    message.value=text;

    sendMessage();

}
</script>

