<div id="chat-launcher">

    <div class="launcher-circle">
        🤖
    </div>

</div>


<div class="chat-container" id="chatContainer">

    <!-- ================= HEADER ================= -->

    <div class="chat-header">

        <div class="chat-header-left">

            <div class="bot-avatar">
                🤖
            </div>

            <div>

                <div class="assistant-title">
                    BALCO Connect AI
                </div>

                <div class="assistant-subtitle">
                    Bhoramdev Vidyapeeth Coaching
                </div>

            </div>

        </div>

        <div class="header-icons">

            <span
                id="resetChat"
                title="New Chat">
                🔄
            </span>

            <span
                id="closeChat"
                title="Close">
                ✖
            </span>

        </div>

    </div>

    <!-- ================= CHAT BODY ================= -->

    <div
        class="chat-body"
        id="chatBody">

        <!-- Welcome Screen -->

        <div
            class="welcome-box"
            id="welcomeBox">

            <div class="welcome-logo">

                🤖

            </div>

            <h2>

                Welcome to

                <br>

                BALCO Connect

            </h2>

            <p>

                Bhoramdev Vidyapeeth Coaching Program

            </p>

           <div class="welcome-card">

    <div>
        📅 Please select your Academic Year
    </div>

    <div
        class="chat-suggestions"
        id="academicYearOptions">

        <button
            type="button"
            class="chat-chip"
            onclick="selectAcademicYear('2025-26')">

            📅 2025-26

        </button>

        <button
            type="button"
            class="chat-chip"
            onclick="selectAcademicYear('2026-27')">

            📅 2026-27

        </button>

        <button
            type="button"
            class="chat-chip"
            onclick="selectAcademicYear('all')">

            📚 All Academic Years

        </button>

    </div>

</div>

            <!-- Quick Buttons -->

            <div class="quick-actions">

                <button onclick="sendQuick('Enrollment')">

                    👨‍🎓 Enrollment

                </button>

                <button onclick="sendQuick('Attendance')">

                    📊 Attendance

                </button>

                <button onclick="sendQuick('Syllabus status')">

                    📚 Syllabus

                </button>

                <button onclick="sendQuick('Achievements')">

                    🏆Achievements

                </button>

                <button onclick="sendQuick('Employment')">

                    💼 Employment

                </button>

                <button onclick="sendQuick('Faculty')">

                    👨‍🏫 Faculty

                </button>

                <button onclick="sendQuick('Latest Notice')">

                    📢 Notice

                </button>

                <button onclick="sendQuick('Library')">

                    📖 Library

                </button>

              </div>

        </div>

        <div id="messages"></div>

    </div>

    <!-- ================= FOOTER ================= -->

    <div class="chat-footer">

        <input

            id="message"

            type="text"

            placeholder="Ask me anything..."

            autocomplete="off"

            onkeypress="if(event.key==='Enter'){sendMessage()}"

        >

        <button

            id="sendBtn"

            onclick="sendMessage()">

            ➤

        </button>

    </div>

</div>

<script>
const launcher = document.getElementById("chat-launcher");
const chatContainer = document.getElementById("chatContainer");
const closeChat = document.getElementById("closeChat");
const resetChat = document.getElementById("resetChat");
const chatBody = document.getElementById("chatBody");
const messages = document.getElementById("messages");
const message = document.getElementById("message");

/* ===================================================
   SELECTED ACADEMIC YEAR
=================================================== */

let selectedAcademicYear = null;
/* ===================================================
   SELECT ACADEMIC YEAR
=================================================== */

function selectAcademicYear(year) {

    selectedAcademicYear = year;

    const displayYear =
        year === "all"
            ? "All Academic Years"
            : year;

    addBotMessage(
        `✅ Academic Year set to ${displayYear}.

You can now ask me about Enrollment, Attendance, Achievements, Employment, Faculty, Syllabus, Notices, Library, etc.`
    );

    message.focus();
}

// Open
launcher.onclick = async () => {

    chatContainer.style.display = "flex";


    /*
       Show academic-year selection only
       when the chatbot is opened for the
       first time.
    */

    if (
        !selectedAcademicYear &&
        messages.children.length === 0
    ) {

        try {

            showTyping();


            const res = await fetch("/api/chat", {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({

                    message: "Select Academic Year"

                })

            });


            const data = await res.json();


            hideTyping();


            addBotMessage(

                data.reply,

                data.suggestions || []

            );


        } catch (err) {

            hideTyping();

            addBotMessage(
                "❌ Unable to load academic years."
            );

        }

    }

};

// Close
closeChat.onclick = () => {
    chatContainer.style.display = "none";
};

// Reset
resetChat.onclick = () => {

    messages.innerHTML = "";

    message.value = "";

    selectedAcademicYear = null;

    chatBody.scrollTop = 0;

};

async function sendMessage() {

    const text = message.value.trim();

    if (!text) return;


    /* ===================================================
       CHECK IF USER SELECTED AN ACADEMIC YEAR
    =================================================== */

    const yearMatch =
        text.match(/\d{4}-\d{2}/);

    if (yearMatch) {

        selectedAcademicYear =
            yearMatch[0];

    }


    addUserMessage(text);

    message.value = "";


    try {

        showTyping();


        /*
           Send selected academic year along with
           every question.

           Example:

           User types:
           Enrollment

           Backend receives:
           Enrollment 2025-26
        */

        let requestText = text;

        if (
            selectedAcademicYear &&
            !yearMatch
        ) {

            requestText =
                `${text} ${selectedAcademicYear}`;

        }


        const res = await fetch("/api/chat", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({

                message: requestText

            })

        });


        const data = await res.json();


        hideTyping();


        addBotMessage(

            data.reply,

            data.suggestions || []

        );


    } catch (err) {

        hideTyping();

        addBotMessage(
            "❌ Unable to connect to AI."
        );

    }

}
function addUserMessage(text){

    messages.insertAdjacentHTML(
        "beforeend",
        `
        <div class="user-message">
            ${text}
        </div>
        `
    );

    scrollBottom();

}

function addBotMessage(reply, suggestions = []) {

    let html = `
        <div class="bot-message">
            ${String(reply ?? "").replace(/\n/g, "<br>")}
    `;

    if (suggestions.length) {

        html += `
            <div class="chat-suggestions">
        `;

        suggestions
            .filter(item => item && !String(item).includes("null"))
            .forEach(item => {

                const safeItem = String(item)
                    .replace(/\\/g, "\\\\")
                    .replace(/'/g, "\\'");

                html += `
                    <button
                        type="button"
                        class="chat-chip"
                        onclick="sendQuick('${safeItem}')">
                        ${item}
                    </button>
                `;

            });

        html += `
            </div>
        `;
    }

    html += `
        </div>
    `;

    messages.insertAdjacentHTML("beforeend", html);

    scrollBottom();
}

function showTyping(){

    messages.insertAdjacentHTML(
        "beforeend",
        `
        <div
            class="bot-message"
            id="typing">

            🤖 Thinking...

        </div>
        `
    );

    scrollBottom();

}

function hideTyping(){

    document
    .getElementById("typing")
    ?.remove();

}

function scrollBottom(){

    chatBody.scrollTop =
    chatBody.scrollHeight;

}
function sendQuick(text) {

    if (!selectedAcademicYear) {

        addBotMessage(
            "📅 Please select your Academic Year first."
        );

        return;

    }

    message.value = text;

    sendMessage();

}
</script>

