<div id="chat-launcher">

    <div class="launcher-circle">
        🤖
    </div>

</div>


<div class="chat-container" id="chatContainer">

    <!-- ================= HEADER ================= -->

    <div class="chat-header">

        <div class="chat-header-left">

            <div class="bot-avatar">
                🤖
            </div>

            <div>

                <div class="assistant-title">
                    BALCO Connect AI
                </div>

                <div class="assistant-subtitle">
                    Bhoramdev Vidyapeeth Coaching
                </div>

            </div>

        </div>

        <div class="header-icons">

            <span
                id="resetChat"
                title="New Chat">
                🔄
            </span>

            <span
                id="closeChat"
                title="Close">
                ✖
            </span>

        </div>

    </div>

    <!-- ================= CHAT BODY ================= -->

    <div
        class="chat-body"
        id="chatBody">

        <!-- Welcome Screen -->

        <div
            class="welcome-box"
            id="welcomeBox">

            <div class="welcome-logo">

                🤖

            </div>

            <h2>

                Welcome to

                <br>

                BALCO Connect

            </h2>

            <p>

                Bhoramdev Vidyapeeth Coaching Program

            </p>

            <div class="welcome-card">

                I can help you with

            </div>

            <!-- Quick Buttons -->

            <div class="quick-actions">

                <button onclick="sendQuick('Enrollment')">

                    👨‍🎓 Enrollment

                </button>

                <button onclick="sendQuick('Attendance')">

                    📊 Attendance

                </button>

                <button onclick="sendQuick('Syllabus status')">

                    📚 Syllabus

                </button>

                <button onclick="sendQuick('Achievements')">

                    🏆Achievements

                </button>

                <button onclick="sendQuick('Employment')">

                    💼 Employment

                </button>

                <button onclick="sendQuick('Faculty')">

                    👨‍🏫 Faculty

                </button>

                <button onclick="sendQuick('Latest Notice')">

                    📢 Notice

                </button>

                <button onclick="sendQuick('Library')">

                    📖 Library

                </button>

            </div>

        </div>

    </div>

    <!-- ================= FOOTER ================= -->

    <div class="chat-footer">

        <input

            id="message"

            type="text"

            placeholder="Ask me anything..."

            autocomplete="off"

            onkeypress="if(event.key==='Enter'){sendMessage()}"

        >

        <button

            id="sendBtn"

            onclick="sendMessage()">

            ➤

        </button>

    </div>

</div>

<script>
const launcher = document.getElementById("chat-launcher");
const chatContainer = document.getElementById("chatContainer");
const closeChat = document.getElementById("closeChat");
const resetChat = document.getElementById("resetChat");
const chatBody = document.getElementById("chatBody");
const message = document.getElementById("message");

// Open
launcher.onclick = () => {
    chatContainer.style.display = "flex";
};

// Close
closeChat.onclick = () => {
    chatContainer.style.display = "none";
};

// Reset
resetChat.onclick = () => {

    chatBody.innerHTML = `
        <div class="welcome-box" id="welcomeBox">

            <div class="welcome-logo">🤖</div>

            <h2>
                Welcome to
                <br>
                BALCO Connect
            </h2>

            <p>Bhoramdev Vidyapeeth Coaching Program</p>

            <div class="welcome-card">
                I can help you with
            </div>

            <div class="quick-actions">

                <button onclick="sendQuick('Enrollment')">👨‍🎓 Enrollment</button>
                <button onclick="sendQuick('Attendance')">📊 Attendance</button>
                <button onclick="sendQuick('Syllabus status')">📚 Syllabus</button>
                <button onclick="sendQuick('Achievements')">🏆 Achievements</button>
                <button onclick="sendQuick('Employment')">💼 Employment</button>
                <button onclick="sendQuick('Faculty')">👨‍🏫 Faculty</button>
                <button onclick="sendQuick('Latest Notice')">📢 Notice</button>
                <button onclick="sendQuick('Library')">📖 Library</button>

            </div>

        </div>
    `;

    message.value = "";

};

async function sendMessage() {

    const text = message.value.trim();

    if (!text) return;

   // Hide welcome screen on first message
const welcomeBox = document.getElementById("welcomeBox");
if (welcomeBox) {
    welcomeBox.style.display = "none";
}

// Show user message
chatBody.innerHTML += `
    <div class="user-message">
        ${text}
    </div>
`;

chatBody.scrollTop = chatBody.scrollHeight;

    message.value = "";

    try {

        // Show loading message
const loading = document.createElement("div");

loading.className = "bot-message";
loading.id = "typing";
loading.innerHTML = "🤖 Thinking...";

chatBody.appendChild(loading);
chatBody.scrollTop = chatBody.scrollHeight;

// Call API
const res = await fetch("/api/chat", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({
                message: text
            })

        });

        const data = await res.json();

// Remove loading message
document.getElementById("typing")?.remove();

        chatBody.innerHTML += `
            <div class="bot-message">
                ${data.reply}
            </div>
        `;

        chatBody.scrollTop = chatBody.scrollHeight;

    } catch (err) {
        document.getElementById("typing")?.remove();

        chatBody.innerHTML += `
            <div class="bot-message">
                ❌ Unable to connect to AI.
            </div>
        `;

    }

}

// Quick Buttons
function sendQuick(text){
    message.value = text;
    sendMessage();
}
</script>

